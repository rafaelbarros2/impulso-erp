  "customCSS": "\n    /* Animações personalizadas */\n    @keyframes luxuryFadeIn {\n      from {\n        opacity: 0;\n        transform: translateY(30px) scale(0.95);\n      }\n      to {\n        opacity: 1;\n        transform: translateY(0) scale(1);\n      }\n    }\n    \n    @keyframes sparkle {\n      0%, 100% { opacity: 1; }\n      50% { opacity: 0.5; }\n    }\n    \n    .product-card {\n      animation: luxuryFadeIn 0.6s ease-out;\n    }\n    \n    .product-card:nth-child(even) {\n      animation-delay: 0.1s;\n    }\n    \n    .product-card:nth-child(odd) {\n      animation-delay: 0.2s;\n    }\n    \n    /* Efeitos de brilho para badges */\n    .badge-featured::before {\n      content: '✨';\n      margin-right: 0.25rem;\n      animation: sparkle 2s infinite;\n    }\n    \n    /* Estilo especial para links do menu */\n    .menu-item {\n      position: relative;\n      overflow: hidden;\n    }\n    \n    .menu-item::before {\n      content: '';\n      position: absolute;\n      top: 0;\n      left: -100%;\n      width: 100%;\n      height: 100%;\n      background: linear-gradient(90deg, transparent, rgba(194, 24, 91, 0.1), transparent);\n      transition: left 0.5s;\n    }\n    \n    .menu-item:hover::before {\n      left: 100%;\n    }\n    \n    /* Responsividade aprimorada */\n    @media (max-width: 768px) {\n      .product-card {\n        border-radius: 16px;\n        padding: 20px;\n      }\n      \n      .menu {\n        padding: 1rem;\n      }\n      \n      .logo-text {\n        font-size: 1.25rem !important;\n      }\n    }\n    \n    /* Dark mode automático */\n    @media (prefers-color-scheme: dark) {\n      body {\n        background: linear-gradient(135deg, #1a0a2e 0%, #16213e 50%, #0f3460 100%) !important;\n      }\n      \n      .product-card {\n        background: linear-gradient(145deg, #2d1b69 0%, #4a148c 50%, #2d1b69 100%) !important;\n        color: #fce4ec !important;\n        border-color: #7b1fa2 !important;\n      }\n      \n      .menu {\n        background: linear-gradient(90deg, #1a0a2e 0%, #2d1b69 100%) !important;\n        border-color: #7b1fa2 !important;\n      }\n    }\n  ",

