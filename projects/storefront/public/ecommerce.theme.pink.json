      "padding": {
        "sm": { "$value": "0.5rem 1rem", "$type": "dimension" },
        "md": { "$value": "0.625rem 1.25rem", "$type": "dimension" },
        "lg": { "$value": "0.75rem 1.5rem", "$type": "dimension" }
      },
      "fontSize": {
        "sm": { "$value": "0.875rem", "$type": "dimension" },
        "md": { "$value": "1rem", "$type": "dimension" },
        "lg": { "$value": "1.125rem", "$type": "dimension" }
      },
      "fontWeight": { "$value": 500, "$type": "fontWeight" }
    },
    "card": {
      "product": {
        "background": { "$value": "#ffffff", "$type": "color" },
        "background-hover": { "$value": "#f9fafb", "$type": "color" },
        "border": { "$value": "#e5e7eb", "$type": "color" },
        "border-hover": { "$value": "#d1d5db", "$type": "color" },
        "shadow": { "$value": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)", "$type": "boxShadow" },
        "shadow-hover": { "$value": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)", "$type": "boxShadow" },
        "padding": { "$value": "1rem", "$type": "dimension" },
        "radius": { "$value": "0.5rem", "$type": "dimension" }
      }
    },
    "header": {
      "background": { "$value": "#ffffff", "$type": "color" },
      "foreground": { "$value": "#111827", "$type": "color" },
      "border": { "$value": "#e5e7eb", "$type": "color" },
      "shadow": { "$value": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)", "$type": "boxShadow" },
      "height": { "$value": "4rem", "$type": "dimension" },
      "padding": { "$value": "1rem", "$type": "dimension" }
    },
    "input": {
      "background": { "$value": "#ffffff", "$type": "color" },
      "foreground": { "$value": "#111827", "$type": "color" },
      "border": { "$value": "#e5e7eb", "$type": "color" },
      "border-focus": { "$value": "#ec4899", "$type": "color" },
      "placeholder": { "$value": "#9ca3af", "$type": "color" },
      "height": { "$value": "2.5rem", "$type": "dimension" },
      "padding": { "$value": "0.5rem 0.75rem", "$type": "dimension" },
      "radius": { "$value": "0.375rem", "$type": "dimension" }
    },
    "badge": {
      "success": {
        "background": { "$value": "#f0fdf4", "$type": "color" },
        "foreground": { "$value": "#16a34a", "$type": "color" },
        "border": { "$value": "#22c55e", "$type": "color" }
      },
      "warning": {
        "background": { "$value": "#fffbeb", "$type": "color" },
        "foreground": { "$value": "#d97706", "$type": "color" },
        "border": { "$value": "#f59e0b", "$type": "color" }
      },
      "error": {
        "background": { "$value": "#fef2f2", "$type": "color" },
        "foreground": { "$value": "#dc2626", "$type": "color" },
        "border": { "$value": "#ef4444", "$type": "color" }
      },
      "padding": { "$value": "0.25rem 0.5rem", "$type": "dimension" },
      "fontSize": { "$value": "0.75rem", "$type": "dimension" },
      "radius": { "$value": "0.25rem", "$type": "dimension" }
    },
    "price": {
      "current": {
        "color": { "$value": "#111827", "$type": "color" },
        "fontSize": { "$value": "1.25rem", "$type": "dimension" },
        "fontWeight": { "$value": 600, "$type": "fontWeight" }
      },
      "original": {
        "color": { "$value": "#9ca3af", "$type": "color" },
        "fontSize": { "$value": "1rem", "$type": "dimension" },
        "fontWeight": { "$value": 400, "$type": "fontWeight" },
        "decoration": { "$value": "line-through", "$type": "textDecoration" }
      },
      "discount": {
        "background": { "$value": "#dc2626", "$type": "color" },
        "foreground": { "$value": "#ffffff", "$type": "color" },
        "fontSize": { "$value": "0.75rem", "$type": "dimension" },
        "fontWeight": { "$value": 600, "$type": "fontWeight" }
      }
    }
  },
  "animation": {
    "transition": {
      "fast": { "$value": "150ms ease", "$type": "duration" },
      "normal": { "$value": "200ms ease", "$type": "duration" },
      "slow": { "$value": "300ms ease", "$type": "duration" }
    }
  }
}