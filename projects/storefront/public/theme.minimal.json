{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$version": "1.0.0",
  "$description": "Minimal theme tokens - production optimized",
  "color": {
    "primary": {
      "50": { "$value": "#f0f9ff", "$type": "color" },
      "500": { "$value": "#0ea5e9", "$type": "color" },
      "600": { "$value": "#0284c7", "$type": "color" },
      "900": { "$value": "#0c4a6e", "$type": "color" }
    },
    "secondary": {
      "50": { "$value": "#f8fafc", "$type": "color" },
      "500": { "$value": "#64748b", "$type": "color" },
      "900": { "$value": "#0f172a", "$type": "color" }
    },
    "success": {
      "50": { "$value": "#f0fdf4", "$type": "color" },
      "500": { "$value": "#22c55e", "$type": "color" }
    },
    "warning": {
      "50": { "$value": "#fffbeb", "$type": "color" },
      "500": { "$value": "#f59e0b", "$type": "color" }
    },
    "error": {
      "50": { "$value": "#fef2f2", "$type": "color" },
      "500": { "$value": "#ef4444", "$type": "color" }
    },
    "neutral": {
      "0": { "$value": "#ffffff", "$type": "color" },
      "100": { "$value": "#f3f4f6", "$type": "color" },
      "500": { "$value": "#6b7280", "$type": "color" },
      "900": { "$value": "#111827", "$type": "color" }
    },
    "surface": {
      "background": { "$value": "#ffffff", "$type": "color" },
      "foreground": { "$value": "#0f172a", "$type": "color" },
      "border": { "$value": "#e2e8f0", "$type": "color" }
    }
  },
  "radius": {
    "sm": { "$value": "0.125rem", "$type": "dimension" },
    "md": { "$value": "0.375rem", "$type": "dimension" },
    "lg": { "$value": "0.5rem", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "font": {
    "family": {
      "sans": { "$value": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif", "$type": "fontFamily" }
    },
    "size": {
      "sm": { "$value": "0.875rem", "$type": "dimension" },
      "base": { "$value": "1rem", "$type": "dimension" },
      "lg": { "$value": "1.125rem", "$type": "dimension" },
      "xl": { "$value": "1.25rem", "$type": "dimension" }
    },
    "weight": {
      "normal": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" }
    }
  },
  "spacing": {
    "2": { "$value": "0.5rem", "$type": "dimension" },
    "4": { "$value": "1rem", "$type": "dimension" },
    "6": { "$value": "1.5rem", "$type": "dimension" },
    "8": { "$value": "2rem", "$type": "dimension" }
  },
  "component": {
    "button": {
      "height": {
        "md": { "$value": "2.5rem", "$type": "dimension" }
      },
      "padding": {
        "md": { "$value": "0.625rem 1rem", "$type": "dimension" }
      }
    },
    "input": {
      "height": { "$value": "2.5rem", "$type": "dimension" },
      "padding": { "$value": "0.625rem 1rem", "$type": "dimension" }
    }
  }
}